{
  "name": "nmorph-lib-docs",
  "private": true,
  "type": "module",
  "version": "0.0.8",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --no-qr --host 127.0.0.1 --port 43117 --open",
    "clean": "rm -rf .nuxt node_modules && pnpm install",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "check": "pnpm run typecheck && pnpm run build",
    "generate-component": "node generate-component.js",
    "deploy": "pnpm run generate && gh-pages -d dist"
  },
  "dependencies": {
    "@nmorph/nmorph-ui-kit": "workspace:*",
    "@nuxtjs/i18n": "^8.3.1",
    "highlight.js": "10.7.3",
    "nuxt": "^3.11.2",
    "nuxt-svgo": "^4.0.1",
    "pinia": "^2.2.6",
    "vue": "^3.4.27",
    "vue-router": "^4.3.2",
    "vue3-highlightjs": "^1.0.5"
  },
  "devDependencies": {
    "sass": "^1.77.4",
    "typescript": "~5.4.5",
    "vue-tsc": "^2.2.12"
  }
}
