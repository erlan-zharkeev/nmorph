{
  "name": "nmorph-lib-docs",
  "private": true,
  "type": "module",
  "version": "0.0.8",
  "scripts": {
    "prepare:library": "sh -c 'test -x ../library/node_modules/.bin/vue-tsc || npm --prefix ../library install --include=dev --no-fund --no-audit; npm --prefix ../library run build'",
    "build": "npm run prepare:library && nuxt build",
    "dev": "npm run prepare:library && nuxt dev --no-qr --open",
    "clean": "rm -rf .nuxt node_modules && npm install",
    "generate": "npm run prepare:library && nuxt generate",
    "preview": "npm run prepare:library && nuxt preview",
    "postinstall": "nuxt prepare",
    "generate-component": "node generate-component.js",
    "deploy": "npm run generate && gh-pages -d dist"
  },
  "dependencies": {
    "@nmorph/nmorph-ui-kit": "file:../library",
    "@nuxtjs/i18n": "^8.3.1",
    "nuxt": "^3.11.2",
    "nuxt-svgo": "^4.0.1",
    "pinia": "^2.2.6",
    "vue": "^3.4.27",
    "vue-router": "^4.3.2",
    "vue3-highlightjs": "^1.0.5"
  },
  "devDependencies": {
    "sass": "^1.77.4",
    "typescript": "~5.4.5",
    "vue-tsc": "^2.2.12"
  }
}
