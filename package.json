{
  "name": "nmorph",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "postinstall": "pnpm --filter @nmorph/nmorph-ui-kit build && pnpm --filter nmorph-lib-docs exec nuxt prepare && pnpm --filter sandbox exec nuxt prepare",
    "dev": "node scripts/dev-open.mjs docs sandbox",
    "dev:all": "turbo run dev",
    "dev:storybook": "turbo run dev --filter=@nmorph/nmorph-ui-kit",
    "dev:sandbox": "node scripts/dev-open.mjs sandbox",
    "dev:docs": "node scripts/dev-open.mjs docs",
    "build": "turbo run build",
    "build:library": "turbo run build --filter=@nmorph/nmorph-ui-kit",
    "build:docs": "turbo run build --filter=nmorph-lib-docs",
    "build:sandbox": "turbo run build --filter=sandbox",
    "generate:docs": "turbo run generate --filter=nmorph-lib-docs",
    "preview:docs": "turbo run preview --filter=nmorph-lib-docs",
    "lint": "turbo run lint",
    "lint:check": "turbo run lint:check",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "pnpm lint:check && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "turbo": "^2.9.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "vue-demi"
    ]
  }
}
