{
  "name": "@nmorph/nmorph-ui-kit",
  "type": "module",
  "private": false,
  "version": "3.0.15",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erlan-zharkeev/nmorph.git",
    "directory": "library"
  },
  "engines": {
    "node": ">=18.13.0"
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.umd.js",
  "module": "./dist/index.es.js",
  "style": "./dist/style.css",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.es.js"
      },
      "require": "./dist/index.umd.js"
    },
    "./plugin": {
      "types": "./dist/src/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./icons": {
      "types": "./dist/src/icons.d.ts",
      "import": "./dist/icons.js"
    },
    "./styles": {
      "types": "./dist/src/styles.d.ts",
      "import": "./dist/styles.js"
    },
    "./emoji": {
      "types": "./dist/src/components/data/nmorph-emoji-picker/emoji/index.d.ts",
      "import": "./dist/emoji/index.js"
    },
    "./emoji/en": {
      "types": "./dist/src/components/data/nmorph-emoji-picker/emoji/locales/en.d.ts",
      "import": "./dist/emoji/locales/en.js"
    },
    "./emoji/ru": {
      "types": "./dist/src/components/data/nmorph-emoji-picker/emoji/locales/ru.d.ts",
      "import": "./dist/emoji/locales/ru.js"
    },
    "./emoji/zh": {
      "types": "./dist/src/components/data/nmorph-emoji-picker/emoji/locales/zh.d.ts",
      "import": "./dist/emoji/locales/zh.js"
    },
    "./styles.css": "./dist/style.css",
    "./style.css": "./dist/style.css",
    "./nuxt": {
      "types": "./dist/src/nuxt/module.d.ts",
      "import": "./dist/nuxt.mjs",
      "default": "./dist/nuxt.mjs"
    },
    "./components/*": {
      "types": "./dist/src/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./dist/index.d.ts": "./dist/index.d.ts",
    "./dist/style.css": "./dist/style.css",
    "./dist/styles/abstracts/_variables.scss": "./dist/styles/abstracts/_variables.scss",
    "./dist/styles/abstracts/_mixins.scss": "./dist/styles/abstracts/_mixins.scss",
    "./dist/styles/abstracts/_functions.scss": "./dist/styles/abstracts/_functions.scss",
    "./dist/styles/main.scss": "./dist/styles/main.scss"
  },
  "scripts": {
    "dev": "storybook dev -p 43183",
    "storybook": "storybook dev -p 43183",
    "build:storybook": "storybook build",
    "build": "pnpm run build:types && vite build && vite build --config vite.umd.config.ts && vite build --config vite.nuxt.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "watch": "vite build --watch",
    "lint:es:check": "eslint --ext .js,.ts,.vue --ignore-path .gitignore src/",
    "lint:es": "eslint --ext .js,.ts,.vue --ignore-path .gitignore --fix src/",
    "lint:style:check": "stylelint ./src/**/*.{scss,vue}",
    "lint:style": "stylelint ./src/**/*.{scss,vue} --fix",
    "lint:check": "pnpm run lint:es:check && pnpm run lint:style:check",
    "lint": "pnpm run lint:es && pnpm run lint:style",
    "dev:type": "vue-tsc -p ./tsconfig.json",
    "typecheck": "vue-tsc -p ./tsconfig.json",
    "check": "pnpm run lint:check && pnpm run typecheck && pnpm run test",
    "build:types": "vue-tsc --declaration --emitDeclarationOnly --outDir dist"
  },
  "peerDependencies": {
    "nuxt": ">=3.0.0",
    "vue": ">=3.4.0",
    "vue-i18n": ">=9.0.0"
  },
  "peerDependenciesMeta": {
    "nuxt": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nuxt/kit": "^3.13.1",
    "@nuxt/schema": "^3.13.1",
    "@storybook/addon-docs": "10.3.6",
    "@storybook/builder-vite": "10.3.6",
    "@storybook/vue3": "10.3.6",
    "@storybook/vue3-vite": "10.3.6",
    "@types/node": "^20.10.8",
    "@typescript-eslint/eslint-plugin": "^6.18.1",
    "@typescript-eslint/parser": "^6.18.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/server-renderer": "3.5.34",
    "@vue/test-utils": "^2.4.10",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-storybook": "^0.6.15",
    "eslint-plugin-vue": "^9.19.2",
    "happy-dom": "^15.11.7",
    "prettier": "^3.1.1",
    "sass": "^1.69.7",
    "storybook": "10.3.6",
    "stylelint": "^16.1.0",
    "stylelint-config-idiomatic-order": "^10.0.0",
    "stylelint-config-rational-order": "^0.0.4",
    "stylelint-config-recommended-scss": "^14.0.0",
    "stylelint-config-recommended-vue": "^1.5.0",
    "stylelint-config-standard": "^36.0.0",
    "stylelint-config-standard-scss": "^13.0.0",
    "stylelint-order": "^6.0.4",
    "stylelint-prettier": "^5.0.0",
    "stylelint-scss": "^6.0.0",
    "typescript": "~5.1.6",
    "vite": "^5.4.21",
    "vite-plugin-dts": "^4.3.0",
    "vite-svg-loader": "^5.1.0",
    "vitest": "2.1.9",
    "vue": "^3.5.13",
    "vue-eslint-parser": "^9.4.0",
    "vue-i18n": "^9.9.0",
    "vue-tsc": "^1.6.5"
  }
}
